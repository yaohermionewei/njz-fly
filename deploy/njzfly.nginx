server {
    listen 80;
    listen [::]:80;
    server_name njzfly.wystudio.zone;

    location ^~ /.well-known/acme-challenge/ {
        root /var/www/letsencrypt;
        default_type text/plain;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name njzfly.wystudio.zone;

    root /var/www/njzfly/current;
    index index.html;

    ssl_certificate /etc/letsencrypt/live/njzfly.wystudio.zone/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/njzfly.wystudio.zone/privkey.pem;
    include /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;

    location / {
        try_files $uri $uri/ /index.html;
        add_header Cache-Control "no-cache";
    }

    location /assets/ {
        try_files $uri =404;
        expires 30d;
        add_header Cache-Control "public, max-age=2592000, immutable";
    }

    # Only Vite's hashed /assets/ files are immutable. Stable font/icon URLs
    # revalidate so a deployment cannot leave users with stale artwork.
    location ~* \.(?:webp|woff2|mp3)$ {
        try_files $uri =404;
        add_header Cache-Control "public, max-age=0, must-revalidate";
    }
}
